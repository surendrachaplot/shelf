{
  "expo": {
    "name": "shelf",
    "slug": "shelf",
    "owner": "surendrachaplot",
    "scheme": "shelf",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.surendrachaplot.shelf",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.surendrachaplot.shelf"
        ],
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.surendrachaplot.shelf"
        ]
      }
    },
    "android": {
      "package": "com.surendrachaplot.shelf",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "icon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-light.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      "./plugins/withShareExtensionKeychain",
      [
        "expo-share-extension",
        {
          "activationRules": [
            {
              "type": "url",
              "max": 1
            },
            {
              "type": "text",
              "max": 1
            },
            {
              "type": "image",
              "max": 1
            }
          ],
          "height": 420
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fbcc18b2-4a0a-47ba-ac6b-bd331cd8dc92"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/fbcc18b2-4a0a-47ba-ac6b-bd331cd8dc92"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/icon.png"
  }
}
