{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_SHELF_API": "https://shelf-api-u8xy.onrender.com",
        "EXPO_PUBLIC_SHELF_KEY": "$SHELF_APP_KEY",
        "EXPO_PUBLIC_SHELF_WEB": "https://shelf-api-u8xy.onrender.com"
      },
      "channel": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_SHELF_API": "https://shelf-api-u8xy.onrender.com",
        "EXPO_PUBLIC_SHELF_KEY": "$SHELF_APP_KEY",
        "EXPO_PUBLIC_SHELF_WEB": "https://shelf-api-u8xy.onrender.com"
      },
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    }
  }
}
