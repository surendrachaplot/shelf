{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_SHELF_API": "https://shelf-api-u8xy.onrender.com",
        "EXPO_PUBLIC_SHELF_KEY": "$SHELF_APP_KEY"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_SHELF_API": "https://shelf-api-u8xy.onrender.com",
        "EXPO_PUBLIC_SHELF_KEY": "$SHELF_APP_KEY"
      },
      "channel": "preview"
    }
  }
}
