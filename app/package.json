{
  "name": "shelf",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild -p ios --clean",
    "ios": "expo run:ios",
    "build:dev": "npx --yes eas-cli@latest build -p ios --profile development",
    "build:preview": "npx --yes eas-cli@latest build -p ios --profile preview",
    "verify": "node verify-design.mjs && node verify-design.mjs --selftest && node preview/build.mjs && node preview/measure.mjs",
    "frames": "node verify-design.mjs --frames",
    "preview": "node preview/build.mjs && node preview/shoot.mjs && node preview/measure.mjs",
    "lab": "node design-lab/shoot.mjs",
    "e2e": "node ../api/e2e.mjs",
    "eas": "npx --yes eas-cli@latest",
    "android": "expo run:android"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-dev-client": "~5.0.20",
    "expo-file-system": "~18.0.0",
    "expo-linear-gradient": "~14.0.1",
    "expo-secure-store": "~14.0.0",
    "expo-share-extension": "^5.0.6",
    "expo-updates": "~0.27.5",
    "react": "^18.3.1",
    "react-native": "0.76.5",
    "react-native-svg": "^15.8.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.49.0",
    "react-dom": "^18.3.1",
    "react-native-web": "^0.19.13",
    "typescript": "^5.3.3"
  }
}
