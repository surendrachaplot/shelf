// search.js — find a thing and put it on a shelf, with no reel involved.
//
// Sharing a reel is how shelf gets used at 1am. This is how it gets used when
// someone tells you about a restaurant over dinner, and it has to be just as
// short a path: type, tap, done.
//
// Five searchable providers, five different shapes, ONE result envelope — the
// same discipline `resolve.js` applies to caption extraction, for the same
// reason. A renderer that has to know which provider produced a row is a
// renderer that grows a branch per provider and then a bug per branch.
// (Quotes are the sixth shelf and have no search: there is no catalogue of
// things people said — see enrich/index.js.)
//
// Every provider is OPTIONAL. Books, recipes and places need no key at all;
// movies needs a free TMDB key. Restaurants PREFERS a Google Places key but no
// longer NEEDS one — OpenStreetMap (Nominatim) answers it for free, the same
// way enrich/index.js already resolves restaurants and travel places with no
// key at all. A missing key produces a NAMED, VISIBLE absence, never an empty
// result that reads as "we looked and there is nothing" — §8 is explicit that
// those must not render the same way, and it applies to a search box as much
// as to a shelf. Restaurants and places no longer have that kind of absence at
// all: OSM means there is always an answer to try.
import { isMain } from "./ismain.js";
import { fetchT, BROWSER_HEADERS } from "./net.js";
import { query, dbReady } from "./db.js";
import { json, normList } from "./http.js";
import { parseLd, extractWebPage } from "./resolve.js";
import { pickOsmPlace } from "./enrich/index.js";

export const PROVIDERS = {
  books: { name: "Open Library", key: null },
  movies: { name: "TMDB", key: "TMDB_API_KEY" },
  // `key: null` deliberately — OpenStreetMap is the fallback, so restaurants
  // are never "switched off" the way movies are with no TMDB key. Whether the
  // Google-paid path or the free OSM path actually answers a given request is
  // decided inside searchRestaurants(), not here.
  restaurants: { name: "Google Places", key: null },
  recipes: { name: "the page itself", key: null },
  // Always keyless. This is the newest of the six shelves the app knows about
  // (search only knew four providers before this) and OSM is the only
  // provider that ever answers it — there is no paid alternative to prefer.
  places: { name: "OpenStreetMap", key: null },
};

export const providerReady = (list) => {
  const p = PROVIDERS[list];
  return !p ? false : !p.key || !!process.env[p.key];
};

/**
 * The envelope. `key` is the CATALOGUE identity — it is what stops the same
 * book being added twice, and it is why every provider must produce one.
 */
export function result({ list, key, title, subtitle, imageUrl, canonical, provider }) {
  return {
    list, key: `${list}:${key}`, title, subtitle: subtitle || null,
    image_url: imageUrl || null, canonical: { ...(canonical || {}), key: `${list}:${key}` },
    provider,
  };
}

const jsonGet = async (url, opts = {}, ms = 9000) => {
  const r = await fetchT(url, { headers: { Accept: "application/json", ...(opts.headers || {}) }, ...opts }, ms);
  if (!r.ok) throw new Error(`${r.status}`);
  return r.json();
};

// ── the cache ────────────────────────────────────────────────────────────────
// Searches are cached exactly like enrichments, MISSES INCLUDED. A search box
// is the worst possible thing to leave uncached against a metered provider:
// every keystroke past the debounce is a paid question, and "nothing matched
// 'ganapat'" is a real, reusable answer.
async function cachedSearch(provider, key, fetcher) {
  if (!dbReady()) return fetcher();
  const r = await query(
    "select found, payload from provider_cache where provider = $1 and cache_key = $2",
    [`search:${provider}`, key]
  );
  if (r.rows.length) return r.rows[0].found ? r.rows[0].payload : [];
  let value = [];
  try { value = await fetcher(); }
  catch (_) { return []; }   // a network failure is NOT a cached miss
  await query(
    `insert into provider_cache (provider, cache_key, found, payload)
     values ($1, $2, $3, $4) on conflict (provider, cache_key)
     do update set found = excluded.found, payload = excluded.payload, created_at = now()`,
    [`search:${provider}`, key, value.length > 0, JSON.stringify(value)]
  );
  return value;
}

// ── books: Open Library, keyless ─────────────────────────────────────────────

export function bookResults(docs = []) {
  return docs.filter((d) => d.title).slice(0, 8).map((d) =>
    result({
      list: "books",
      key: d.key || d.cover_edition_key || `${d.title}|${(d.author_name || [])[0] || ""}`,
      title: d.title,
      subtitle: [(d.author_name || [])[0], d.first_publish_year].filter(Boolean).join(" · ") || null,
      imageUrl: d.cover_i ? `https://covers.openlibrary.org/b/id/${d.cover_i}-L.jpg` : null,
      canonical: { openlibrary_key: d.key, isbn: (d.isbn || [])[0] || null, year: d.first_publish_year || null },
      provider: "Open Library",
    })
  );
}

export const searchBooks = (q) =>
  cachedSearch("books", q, async () => {
    const r = await jsonGet(`https://openlibrary.org/search.json?limit=8&fields=key,title,author_name,first_publish_year,cover_i,isbn&q=${encodeURIComponent(q)}`);
    return bookResults(r.docs);
  });

// ── movies & TV: TMDB, free key ──────────────────────────────────────────────

export function movieResults(hits = []) {
  return hits
    .filter((h) => (h.media_type === "movie" || h.media_type === "tv" || !h.media_type) && (h.title || h.name))
    .slice(0, 8)
    .map((h) => {
      const date = h.release_date || h.first_air_date || "";
      return result({
        list: "movies",
        key: `${h.media_type || "movie"}/${h.id}`,
        title: h.title || h.name,
        subtitle: [date.slice(0, 4), h.media_type === "tv" ? "TV" : null].filter(Boolean).join(" · ") || null,
        imageUrl: h.poster_path ? `https://image.tmdb.org/t/p/w500${h.poster_path}` : null,
        canonical: { tmdb_id: h.id, tmdb_type: h.media_type || "movie", year: date.slice(0, 4) || null },
        provider: "TMDB",
      });
    });
}

export const searchMovies = (q) =>
  !process.env.TMDB_API_KEY ? Promise.resolve([]) : cachedSearch("movies", q, async () => {
    const r = await jsonGet(`https://api.themoviedb.org/3/search/multi?include_adult=false&query=${encodeURIComponent(q)}&api_key=${process.env.TMDB_API_KEY}`);
    return movieResults(r.results);
  });

// ── restaurants: Google Places when a key is set, OSM when it is not ───────

export function placeResults(places = []) {
  return places.filter((p) => p.name).slice(0, 8).map((p) =>
    result({
      list: "restaurants",
      key: p.place_id || p.id || p.name,
      title: p.name,
      subtitle: p.formatted_address || p.vicinity || null,
      // Deliberately no photo: a Places photo is a second billed request per
      // result, and eight of those per keystroke is how a search box becomes a
      // line item. The typographic jacket is the designed answer for this.
      imageUrl: null,
      canonical: {
        place_id: p.place_id || p.id || null,
        address: p.formatted_address || p.vicinity || null,
        lat: p.geometry?.location?.lat ?? null,
        lng: p.geometry?.location?.lng ?? null,
      },
      provider: "Google Places",
    })
  );
}

// Unchanged in behaviour from before this fallback existed: same endpoint,
// same query shape, same cache namespace — a deploy with GOOGLE_PLACES_KEY set
// sees no difference at all.
async function searchRestaurantsGoogle(q, city) {
  return cachedSearch("restaurants", [q, city].filter(Boolean).join("|"), async () => {
    const r = await jsonGet(
      `https://maps.googleapis.com/maps/api/place/textsearch/json?query=${encodeURIComponent([q, city].filter(Boolean).join(" "))}&type=restaurant&key=${process.env.GOOGLE_PLACES_KEY}`
    );
    return placeResults(r.results);
  });
}

// Nominatim will happily match a bookshop or a bus stop by name — `class` and
// `type` ride along on every search row for free, so filtering to food-ish
// amenities costs nothing extra and stops a restaurant search filling up with
// places that are not restaurants.
const FOOD_TYPES = new Set([
  "restaurant", "cafe", "fast_food", "bar", "pub",
  "food_court", "biergarten", "ice_cream",
]);
export const looksLikeFood = (row) => !!row && row.class === "amenity" && FOOD_TYPES.has(row.type);

// Its own cache namespace ("restaurants_osm", not "restaurants") so toggling
// GOOGLE_PLACES_KEY on or off in production can never read the other source's
// cached rows back — the same discipline as enrich's SHAPE version, applied to
// a source change instead of a shape change.
async function searchRestaurantsOsm(q, city) {
  return cachedSearch("restaurants_osm", [q, city].filter(Boolean).join("|"), async () => {
    const rows = await osmSearch(q, city);
    return osmResults("restaurants", rows.filter(looksLikeFood));
  });
}

export const searchRestaurants = (q, city) =>
  process.env.GOOGLE_PLACES_KEY ? searchRestaurantsGoogle(q, city) : searchRestaurantsOsm(q, city);

// ── places: OpenStreetMap, always — the app's sixth shelf, first time search
// has known about it ──────────────────────────────────────────────────────

// Identifying and contactable, exactly as enrich/index.js's OSM_UA is —
// Nominatim's usage policy requires a real User-Agent, and an anonymous
// scraper UA is how a shared service gets an IP blocked for everybody who
// uses it, not just this one caller.
const OSM_UA = process.env.SHELF_OSM_UA
  || "shelf/0.1 (personal shelf app; +https://github.com/surendrachaplot/shelf)";

// Nominatim's usage policy is ONE REQUEST AT A TIME. Within a single
// searchAll() call, restaurants (OSM fallback) and places can both want an OSM
// answer for the same keystroke — this queue is what stops that becoming two
// requests in flight at once. A failed request does not wedge the ones behind
// it: the chain always continues past either outcome.
let osmQueue = Promise.resolve();
function throughOsmQueue(fn) {
  const run = osmQueue.then(fn, fn);
  osmQueue = run.then(() => undefined, () => undefined);
  return run;
}

async function osmSearch(q, city) {
  return throughOsmQueue(async () => {
    const params = new URLSearchParams({
      q: [q, city].filter(Boolean).join(" "),
      format: "jsonv2", limit: "8", addressdetails: "1", extratags: "1", namedetails: "1",
    });
    const rows = await jsonGet(`https://nominatim.openstreetmap.org/search?${params}`, {
      headers: { "User-Agent": OSM_UA },
    });
    return Array.isArray(rows) ? rows : [];
  });
}

/**
 * `pickOsmPlace` is the exact function enrich/index.js uses to shape a
 * Nominatim row into a place — same title, same address, same OSM canonical
 * fields — so a row picked here and the same row picked while enriching a
 * shared reel carry identical data. Not reimplemented, imported.
 *
 * A near-match is not dropped here the way enrichment's `nameFound()` refuses
 * one: search is lower-stakes, because a person looks at the row and picks it
 * rather than the app committing to it unattended. What IS kept from that
 * lesson is the other half of it — the title on every row is OSM's own name
 * (`pickOsmPlace` reads it off `namedetails`/`display_name`), never the query
 * text echoed back, so a result that is not quite the right place is still
 * honestly labelled as whatever it actually is.
 */
export function osmResults(list, rows = []) {
  return rows
    .map((r) => pickOsmPlace(r))
    .filter((p) => p && p.title)
    .slice(0, 8)
    .map((p) =>
      result({
        list,
        // osm_type/osm_id namespaces the same way a Google place_id does;
        // falling back to the title only happens for the row shape tests use,
        // never in practice — Nominatim always returns both.
        key: p.canonical.osm_type && p.canonical.osm_id
          ? `${p.canonical.osm_type}/${p.canonical.osm_id}` : p.title,
        title: p.title,
        subtitle: p.subtitle || p.canonical.area || null,
        // No photo, same rule and same reasoning as placeResults(): every
        // result in a search list costs the same, one lookup, never a second
        // request per row for a picture.
        imageUrl: null,
        canonical: p.canonical,
        provider: "OpenStreetMap",
      })
    );
}

export const searchPlaces = (q, city) =>
  cachedSearch("places", [q, city].filter(Boolean).join("|"), async () => {
    const rows = await osmSearch(q, city);
    return osmResults("places", rows);
  });

// ── recipes: the page itself, keyless ────────────────────────────────────────
// There is no good general recipe search that is free, and inventing one out of
// a web search would return blogspam. What there IS, reliably, is schema.org
// Recipe markup on the page someone is actually looking at — so for recipes the
// query is a URL, and pasting one is the interaction.

export const looksLikeUrl = (q) => /^https?:\/\/\S+$/i.test(String(q || "").trim());

export async function searchRecipeUrl(url) {
  try {
    const r = await fetchT(url, { headers: BROWSER_HEADERS }, 9000);
    if (!r.ok) return [];
    const html = await r.text();
    const nodes = parseLd(html);
    const recipe = nodes.find((n) => /Recipe/i.test([].concat(n["@type"] || []).join(" ")));
    const page = extractWebPage(html, url);
    const title = recipe?.name || page?.title;
    if (!title) return [];
    return [result({
      list: "recipes",
      key: url,
      title,
      subtitle: recipe?.recipeYield || recipe?.author?.name || new URL(url).hostname.replace(/^www\./, ""),
      imageUrl: (Array.isArray(recipe?.image) ? recipe.image[0] : recipe?.image?.url || recipe?.image) || page?.imageUrl || null,
      canonical: { recipe_url: url, yield: recipe?.recipeYield || null, time: recipe?.totalTime || null },
      provider: "the page itself",
    })];
  } catch (_) {
    return [];
  }
}

// ── the one search ───────────────────────────────────────────────────────────

/**
 * Everything at once, in one envelope, with the providers that could not answer
 * NAMED rather than silently missing. `unavailable` is the difference between
 * "no films matched" and "films are switched off because there is no key" —
 * §8, and the reason the Add screen can tell the truth instead of looking
 * broken to someone who never set TMDB_API_KEY.
 */
export async function searchAll(q, { city = null, only = null } = {}) {
  const term = String(q || "").trim();
  if (term.length < 2) return { results: [], unavailable: [] };

  if (looksLikeUrl(term)) {
    return { results: await searchRecipeUrl(term), unavailable: [], mode: "url" };
  }

  // "places" joins the default set here too — the Add screen's own copy
  // already promises "A book, a place, a film" and this is what makes that
  // true rather than aspirational.
  const wanted = only ? [only] : ["books", "movies", "restaurants", "places"];
  const unavailable = wanted.filter((l) => !providerReady(l)).map((l) => ({ list: l, provider: PROVIDERS[l].name }));

  const jobs = wanted.filter(providerReady).map((l) =>
    (l === "books" ? searchBooks(term)
      : l === "movies" ? searchMovies(term)
      : l === "restaurants" ? searchRestaurants(term, city)
      : searchPlaces(term, city))   // "places"
      .then((r) => r, () => [])
  );
  const got = (await Promise.all(jobs)).flat();

  // Interleave by list rather than concatenating. Eight books followed by eight
  // films means the films are below the fold on every search, which quietly
  // turns a four-shelf app into a book app.
  return { results: interleave(got), unavailable, mode: "query" };
}

export function interleave(rows) {
  const byList = new Map();
  for (const r of rows) (byList.get(r.list) ?? byList.set(r.list, []).get(r.list)).push(r);
  const out = [];
  for (let i = 0; out.length < rows.length; i++) {
    let moved = false;
    for (const list of byList.values()) {
      if (list[i]) { out.push(list[i]); moved = true; }
    }
    if (!moved) break;
  }
  return out;
}

// ── routes ───────────────────────────────────────────────────────────────────

export async function searchRoute(req, res, url) {
  const q = url.searchParams.get("q") || "";
  const only = url.searchParams.get("list");
  // The city comes from the request now, not from a user row — the device
  // knows where you are and this service has no profile to look it up in.
  const city = (url.searchParams.get("city") || "").slice(0, 80) || null;
  const out = await searchAll(q, { city, only: only && PROVIDERS[only] ? only : null });
  return json(res, 200, { ok: true, ...out });
}

// `addRoute` used to live here and wrote a row into the server's items table.
// It is gone with that table: a search is a stateless question now, and what
// you do with the answer — keep it, name it, put it on a shelf — happens on
// the phone. The server never learns which result you picked.

// ── selftest ─────────────────────────────────────────────────────────────────

if (isMain(import.meta.url)) {
  if (process.argv.includes("--selftest")) {
    let n = 0, bad = 0;
    const ok = (cond, msg) => { n++; if (!cond) { bad++; console.error("FAIL", msg); } };

    const books = bookResults([
      { key: "/works/OL1W", title: "Piranesi", author_name: ["Susanna Clarke"], first_publish_year: 2020, cover_i: 42, isbn: ["978"] },
      { key: "/works/OL2W" },  // no title — must be dropped, not rendered blank
    ]);
    ok(books.length === 1, "a result with no title was kept");
    ok(books[0].subtitle === "Susanna Clarke · 2020", `book subtitle was ${books[0].subtitle}`);
    ok(books[0].image_url.includes("covers.openlibrary.org"), "book cover url");
    ok(books[0].key === "books:/works/OL1W", "book catalogue key must be namespaced by list");
    ok(books[0].canonical.key === books[0].key, "canonical.key must match — the dedupe index reads it, not the envelope");

    const films = movieResults([
      { media_type: "movie", id: 7, title: "Sinners", release_date: "2025-04-18", poster_path: "/p.jpg" },
      { media_type: "person", id: 9, name: "Someone" },   // must not become an item
    ]);
    ok(films.length === 1, "a person came back as a film");
    ok(films[0].subtitle === "2025", `film subtitle was ${films[0].subtitle}`);

    const googlePlaces = placeResults([{ place_id: "p1", name: "Ganapati", formatted_address: "38 Holly Grove" }]);
    ok(googlePlaces[0].image_url === null, "a Places result must not carry a photo — that is a second billed request per row");
    ok(googlePlaces[0].canonical.place_id === "p1", "place_id");

    // ── OSM: the keyless fallback for restaurants, and the only provider
    // places has ever had. Fixture rows, shaped exactly like Nominatim's
    // jsonv2 response — no network, same discipline as every other *Results().
    const osmRows = [
      {
        osm_type: "node", osm_id: 101, lat: "51.47", lon: "-0.07",
        display_name: "Ganapati, 38 Holly Grove, Peckham, London, SE15 5DF",
        namedetails: { name: "Ganapati" },
        address: { suburb: "Peckham", city: "London" },
        extratags: { cuisine: "indian" },
        class: "amenity", type: "restaurant",
      },
      {
        // A real bookshop that happens to share a search term with a
        // restaurant query — this is the row looksLikeFood() exists to keep
        // off a restaurant shelf.
        osm_type: "way", osm_id: 202, lat: "51.5", lon: "-0.1",
        display_name: "Book Bar, Bounds Green, London",
        namedetails: { name: "Book Bar" },
        address: { suburb: "Bounds Green" },
        extratags: {},
        class: "shop", type: "books",
      },
    ];

    const osmPlacesRows = osmResults("places", osmRows);
    ok(osmPlacesRows.length === 2, "places: every named OSM row becomes a result, food or not — places is deliberately unfiltered");
    ok(osmPlacesRows[0].title === "Ganapati", "a result's title is the place's real name from OSM");
    ok(osmPlacesRows[0].key === "places:node/101", `osm key namespaces by osm_type/osm_id, not the query text — got ${osmPlacesRows[0].key}`);
    ok(osmPlacesRows[0].canonical.key === osmPlacesRows[0].key, "canonical.key must match — same rule as every other provider");
    ok(osmPlacesRows[0].image_url === null, "no photo on an OSM search result — same rule as a Google Places result");
    ok(osmPlacesRows[0].canonical.source === "openstreetmap", "canonical carries the OSM shape pickOsmPlace already produces for enrichment");
    ok(osmPlacesRows[1].title === "Book Bar", "title is OSM's own name, never the query echoed back — true for the near-miss row too");

    ok(looksLikeFood(osmRows[0]) === true, "amenity=restaurant is food");
    ok(looksLikeFood(osmRows[1]) === false, "shop=books is not food, however well the name matched the query");
    ok(looksLikeFood(null) === false && looksLikeFood({}) === false, "no class/type on a row, no match, no crash");

    const osmRestaurantRows = osmResults("restaurants", osmRows.filter(looksLikeFood));
    ok(osmRestaurantRows.length === 1 && osmRestaurantRows[0].title === "Ganapati",
       "restaurants via OSM keep only the food-tagged row — the bookshop must not appear on a restaurant search");
    ok(osmRestaurantRows[0].key === "restaurants:node/101", "the SAME osm row is namespaced per list — no collision with the places entry above");

    ok(osmResults("places", [{ osm_type: "node", osm_id: 1, display_name: "", namedetails: {} }]).length === 0,
       "a nameless osm result must be dropped, not rendered blank — same rule as books");
    ok(osmResults("places", []).length === 0, "osmResults([]) does not crash");

    // The absence must be NAMED — but only when it is actually true. Both
    // restaurants and places have a keyless OSM fallback now, so neither may
    // ever appear in `unavailable`, with or without GOOGLE_PLACES_KEY set.
    ok(!!PROVIDERS.places, "places must be a search provider — the app has six shelves and search must know the searchable ones");
    const savedGP = process.env.GOOGLE_PLACES_KEY;
    delete process.env.GOOGLE_PLACES_KEY;
    ok(providerReady("restaurants") === true, "restaurants must stay ready with no Google key — OSM covers it, so it is never switched off");
    ok(providerReady("places") === true, "places is keyless OSM, always ready");
    if (savedGP) process.env.GOOGLE_PLACES_KEY = savedGP;

    // Interleaving: this is what stops eight books burying every film.
    const mixed = interleave([
      ...Array.from({ length: 3 }, (_, i) => ({ list: "books", key: `b${i}` })),
      ...Array.from({ length: 2 }, (_, i) => ({ list: "movies", key: `m${i}` })),
    ]);
    ok(mixed.length === 5, `interleave lost rows: ${mixed.length}`);
    ok(mixed[0].list === "books" && mixed[1].list === "movies", "interleave did not alternate");
    ok(new Set(mixed.map((r) => r.key)).size === 5, "interleave duplicated a row");
    ok(interleave([]).length === 0, "interleave([])");

    ok(looksLikeUrl("https://x.com/a") && !looksLikeUrl("cacio e pepe"), "url detection");

    // The absence must be NAMED. Without a key this has to say so.
    const saved = process.env.TMDB_API_KEY;
    delete process.env.TMDB_API_KEY;
    ok(providerReady("books") === true, "books need no key");
    ok(providerReady("movies") === false, "movies must report unavailable with no key");
    if (saved) process.env.TMDB_API_KEY = saved;

    const short = await searchAll("a");
    ok(short.results.length === 0, "a one-character query must not hit a provider");

    console.log(bad ? `search selftest FAILED (${bad}/${n})` : `search selftest ok — ${n} assertions`);
    process.exit(bad ? 1 : 0);
  }
}
